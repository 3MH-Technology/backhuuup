# ─────────────────────────────────────────────────────────────
# Estidafa Platform — systemd Service Unit
# ─────────────────────────────────────────────────────────────
# This service starts the entire platform via docker-compose
# and ensures recovery on host reboot.
#
# Install:
#   sudo cp scripts/systemd.service /etc/systemd/system/estidafa.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable estidafa
#   sudo systemctl start estidafa
# ─────────────────────────────────────────────────────────────

[Unit]
Description=Estidafa — Autonomous Micro-SaaS Bot Hosting
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/estidafa
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
StandardOutput=journal
StandardError=journal

# Restart on failure
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
